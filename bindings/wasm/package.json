{
  "name": "kome-sync",
  "version": "0.1.0",
  "description": "Private, distributed, offline-first sync engine (WASM): CRDT core, incremental reconciliation, end-to-end encryption, no central server",
  "license": "MIT",
  "type": "commonjs",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      }
    },
    "./embedded": {
      "browser": {
        "types": "./embedded.d.mts",
        "default": "./embedded.mjs"
      },
      "import": {
        "types": "./embedded.d.mts",
        "default": "./embedded.mjs"
      },
      "require": {
        "types": "./embedded.d.ts",
        "default": "./embedded.cjs"
      }
    }
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "embedded.cjs",
    "embedded.mjs",
    "embedded.d.ts",
    "embedded.d.mts",
    "binding.cjs",
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HershelShah/Kome.git",
    "directory": "bindings/wasm"
  },
  "homepage": "https://github.com/HershelShah/Kome#readme",
  "keywords": [
    "crdt",
    "sync",
    "p2p",
    "offline-first",
    "local-first",
    "replication",
    "e2ee",
    "wasm"
  ],
  "engines": {
    "node": ">=18"
  }
}
