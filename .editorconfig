root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ads,adb,gpr}]
indent_style = space
indent_size = 3

[*.lean]
indent_style = space
indent_size = 2

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
